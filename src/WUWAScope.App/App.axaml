<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WUWAScope.App.App"
             RequestedThemeVariant="Light">
  <Application.Resources>
    <!-- Warm Editorial 2.5D Palette -->
    <Color x:Key="PaperBgColor">#FAF6EE</Color>
    <Color x:Key="PanelBgColor">#FFFDF9</Color>
    <Color x:Key="PanelSubtleBgColor">#F5EFE4</Color>
    <Color x:Key="PanelBorderColor">#E3DACB</Color>
    <Color x:Key="InkColor">#1E2430</Color>
    <Color x:Key="MutedInkColor">#646D7C</Color>
    <Color x:Key="AccentAmberColor">#F6D794</Color>
    <Color x:Key="AccentSkyColor">#C5D9FA</Color>
    <Color x:Key="AccentGreenColor">#2E9E63</Color>
    <Color x:Key="AccentCoralColor">#D9534F</Color>

    <SolidColorBrush x:Key="PaperBgBrush" Color="{StaticResource PaperBgColor}" />
    <SolidColorBrush x:Key="PanelBgBrush" Color="{StaticResource PanelBgColor}" />
    <SolidColorBrush x:Key="PanelSubtleBgBrush" Color="{StaticResource PanelSubtleBgColor}" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="{StaticResource PanelBorderColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="MutedInkBrush" Color="{StaticResource MutedInkColor}" />
    <SolidColorBrush x:Key="AccentAmberBrush" Color="{StaticResource AccentAmberColor}" />
    <SolidColorBrush x:Key="AccentSkyBrush" Color="{StaticResource AccentSkyColor}" />
    <SolidColorBrush x:Key="AccentGreenBrush" Color="{StaticResource AccentGreenColor}" />
    <SolidColorBrush x:Key="AccentCoralBrush" Color="{StaticResource AccentCoralColor}" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="Window">
      <Setter Property="Background" Value="{StaticResource PaperBgBrush}" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="FontFamily" Value="Inter, Segoe UI, Arial" />
    </Style>

    <!-- Primary Dark Ink Action Button -->
    <Style Selector="Button.pill-primary">
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="13,5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.pill-primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#323B4D" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Clean Low-Noise Soft Button (No harsh heavy outlines) -->
    <Style Selector="Button.pill">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="14" />
      <Setter Property="Padding" Value="11,5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.pill:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3ECDF" />
      <Setter Property="BorderBrush" Value="#C9BFA9" />
    </Style>

    <Style Selector="Button.pill:disabled">
      <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- Ultra-light Borderless Ghost Button for Top Bar & Floating Docks -->
    <Style Selector="Button.ghost">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="9,5" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EFE8DA" />
    </Style>

    <Style Selector="Button.ghost:disabled">
      <Setter Property="Opacity" Value="0.4" />
    </Style>

    <!-- Compact Filter Chip -->
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EFE8DA" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style Selector="Button.chip.active">
      <Setter Property="Background" Value="{StaticResource InkBrush}" />
      <Setter Property="Foreground" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- Segmented Tab Button inside Right Panel -->
    <Style Selector="Button.seg-tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,5" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.seg-tab:pointerover /template/ ContentPresenter">
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style Selector="Button.seg-tab.selected">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <!-- Subtle Floating Pill Container (Canvas Overlays) -->
    <Style Selector="Border.floating-dock">
      <Setter Property="Background" Value="#FAFFFDF9" />
      <Setter Property="BorderBrush" Value="#D6CBB8" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="18" />
      <Setter Property="BoxShadow" Value="0 4 14 0 #1A1E2430" />
    </Style>

    <Style Selector="Border.badge-pill">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="12" />
      <Setter Property="Padding" Value="8,3" />
    </Style>

    <!-- VS Code-style Explorer Tree Row Styles -->
    <Style Selector="Button.tree-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="6,4" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Left" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.tree-row:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#EFE8DA" />
    </Style>

    <Style Selector="Button.tree-row.selected">
      <Setter Property="Background" Value="#E7F4EC" />
      <Setter Property="Foreground" Value="#145A32" />
    </Style>

    <Style Selector="Button.tree-chevron">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{StaticResource MutedInkBrush}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="4,2" />
      <Setter Property="Width" Value="20" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.tree-chevron:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#E5DCCB" />
    </Style>

    <!-- Vertical Story Step Row (Clean, borderless hoverable row) -->
    <Style Selector="Button.story-row">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="6,7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>

    <Style Selector="Button.story-row:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F3ECDF" />
    </Style>

    <Style Selector="Button.story-row.selected">
      <Setter Property="Background" Value="#E9F6EE" />
    </Style>
  </Application.Styles>
</Application>
